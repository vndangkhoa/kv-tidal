#!/bin/sh
PACKAGE="kvtidal"
INSTALL_DIR="/var/packages/${PACKAGE}/target"
VAR_DIR="/var/packages/${PACKAGE}/var"
PID_FILE="${VAR_DIR}/${PACKAGE}.pid"
LOG_FILE="${VAR_DIR}/${PACKAGE}.log"
DAEMON="${INSTALL_DIR}/bin/kv-tidal"

start_daemon() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        return 0
    fi
    mkdir -p "$VAR_DIR" "$VAR_DIR/tmp"
    chmod 777 "$VAR_DIR/tmp" 2>/dev/null || true
    chown -R sc-kvtidal:synocache "$VAR_DIR/tmp" 2>/dev/null || true
    export DATA_DIR="${VAR_DIR}"
    export CONFIG_PATH="/var/packages/${PACKAGE}/etc/config.json"
    export WEB_DIR="${INSTALL_DIR}/web"
    export RUST_LOG="info"
    export TMPDIR="${VAR_DIR}/tmp"
    export YT_DLP_PATH="${INSTALL_DIR}/bin/yt-dlp"
    export PATH="${INSTALL_DIR}/bin:/usr/local/bin:/usr/syno/bin:/usr/bin:/bin:/usr/sbin:/sbin:/var/packages/ffmpeg7/target/bin:/var/packages/ffmpeg6/target/bin:/var/packages/ffmpeg/target/bin:/opt/bin:$PATH"

    # Synchronize DSM UI launcher port and INFO adminport with actual configured port
    if [ -f "$CONFIG_PATH" ]; then
        CFG_PORT="$(grep -oE '"port":[[:space:]]*[0-9]+' "$CONFIG_PATH" 2>/dev/null | awk -F: '{print $2}' | tr -d ' ')"
        if [ -n "$CFG_PORT" ]; then
            if [ -f "${INSTALL_DIR}/ui/config" ]; then
                sed -i -E "s|:[0-9]+/?\"|:${CFG_PORT}/\"|g" "${INSTALL_DIR}/ui/config"
                sed -i -E "s/\"port\":[[:space:]]*\"[0-9]+\"/\"port\": \"${CFG_PORT}\"/" "${INSTALL_DIR}/ui/config"
            fi
            if [ -f "/var/packages/${PACKAGE}/INFO" ]; then
                sed -i -E "s/^adminport=.*/adminport=\"${CFG_PORT}\"/" "/var/packages/${PACKAGE}/INFO"
            fi
        fi
    fi

    # 1. Start bundled slskd (Soulseek Lossless P2P Daemon)
    SLSKD_BIN="${INSTALL_DIR}/bin/slskd"
    SLSKD_PID="${VAR_DIR}/slskd.pid"
    SLSKD_LOG="${VAR_DIR}/slskd.log"
    SLSKD_DIR="${VAR_DIR}/slskd"

    if [ -x "$SLSKD_BIN" ]; then
        if [ ! -f "$SLSKD_PID" ] || ! kill -0 $(cat "$SLSKD_PID") 2>/dev/null; then
            IS_PORT_TAKEN=0
            if command -v nc >/dev/null 2>&1; then
                nc -z 127.0.0.1 5030 2>/dev/null && IS_PORT_TAKEN=1
            fi
            if [ "$IS_PORT_TAKEN" -eq 0 ]; then
                mkdir -p "$SLSKD_DIR" "$SLSKD_DIR/incomplete"
                [ ! -e "${INSTALL_DIR}/bin/wwwroot" ] && [ -d "${INSTALL_DIR}/share/slskd/wwwroot" ] && ln -sfn "${INSTALL_DIR}/share/slskd/wwwroot" "${INSTALL_DIR}/bin/wwwroot"
                export SLSKD_APP_DIR="$SLSKD_DIR"
                export SLSKD_CONFIG="$SLSKD_DIR/slskd.yml"
                export SLSKD_NO_AUTH="true"
                export SLSKD_NO_VERSION_CHECK="true"
                export SLSKD_NO_COLOR="true"
                export SLSKD_NO_HTTPS="true"
                nohup "$SLSKD_BIN" --no-https </dev/null >> "$SLSKD_LOG" 2>&1 &
                echo $! > "$SLSKD_PID"
            fi
        fi
    fi

    nohup "$DAEMON" </dev/null >> "$LOG_FILE" 2>&1 &
    DAEMON_PID=$!
    echo $DAEMON_PID > "$PID_FILE"
    sleep 1
    if ! kill -0 $DAEMON_PID 2>/dev/null; then
        rm -f "$PID_FILE"
        return 1
    fi
    return 0
}

stop_daemon() {
    # Stop slskd daemon
    SLSKD_PID="${VAR_DIR}/slskd.pid"
    if [ -f "$SLSKD_PID" ]; then
        SPID=$(cat "$SLSKD_PID")
        kill "$SPID" 2>/dev/null
        for i in 1 2 3; do
            if ! kill -0 "$SPID" 2>/dev/null; then
                break
            fi
            sleep 1
        done
        kill -9 "$SPID" 2>/dev/null
        rm -f "$SLSKD_PID"
    fi

    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        kill "$PID" 2>/dev/null
        for i in 1 2 3 4 5; do
            if ! kill -0 "$PID" 2>/dev/null; then
                break
            fi
            sleep 1
        done
        kill -9 "$PID" 2>/dev/null
        rm -f "$PID_FILE"
    fi
}

daemon_status() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        return 0
    fi
    return 1
}

case "$1" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    status)
        if daemon_status; then
            exit 0
        else
            exit 1
        fi
        ;;
    restart)
        stop_daemon
        start_daemon
        ;;
    log)
        echo "$LOG_FILE"
        ;;
    *)
        exit 1
        ;;
esac
