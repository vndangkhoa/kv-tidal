#!/bin/sh
PACKAGE="kvtidal"
INSTALL_DIR="/var/packages/${PACKAGE}/target"
ETC_DIR="/var/packages/${PACKAGE}/etc"
VAR_DIR="/var/packages/${PACKAGE}/var"

mkdir -p "$ETC_DIR" "$VAR_DIR" "$VAR_DIR/tmp"
chmod 777 "$VAR_DIR/tmp" 2>/dev/null || true

# Auto-detect real music shared folder if left empty or default
DETECTED_MUSIC=""
if [ -x "/usr/syno/sbin/synoshare" ]; then
    DETECTED_MUSIC="$(/usr/syno/sbin/synoshare --get music 2>/dev/null | awk -F'[\\[\\]]' '/Path/{print $2}')"
fi
if [ -z "$DETECTED_MUSIC" ]; then
    for v in /volume2 /volume1 /volume3 /volume4; do
        if [ -d "$v/music" ]; then
            DETECTED_MUSIC="$v/music"
            break
        fi
    done
fi
[ -z "$DETECTED_MUSIC" ] && DETECTED_MUSIC="/volume2/music"

USER_MUSIC_DIR="${wizard_music_dir:-${SYNOPKG_PKG_VAR_wizard_music_dir:-${SYNOPKG_PKG_VAR_music_dir:-}}}"
if [ -z "$USER_MUSIC_DIR" ]; then
    MUSIC_DIR="$DETECTED_MUSIC"
elif [ "$USER_MUSIC_DIR" = "/volume1/music" ] && [ "$DETECTED_MUSIC" != "/volume1/music" ] && [ -d "$DETECTED_MUSIC" ]; then
    MUSIC_DIR="$DETECTED_MUSIC"
else
    MUSIC_DIR="$USER_MUSIC_DIR"
fi

PORT="${wizard_port:-${SYNOPKG_PKG_VAR_wizard_port:-${SYNOPKG_PKG_VAR_port:-26784}}}"
SUB_USER="${wizard_sub_user:-${SYNOPKG_PKG_VAR_wizard_sub_user:-${SYNOPKG_PKG_VAR_subsonic_user:-admin}}}"
SUB_PASS="${wizard_sub_pass:-${SYNOPKG_PKG_VAR_wizard_sub_pass:-${SYNOPKG_PKG_VAR_subsonic_pass:-admin}}}"
WIZARD_SLSK_USER="${wizard_slsk_user:-${SYNOPKG_PKG_VAR_wizard_slsk_user:-}}"
WIZARD_SLSK_PASS="${wizard_slsk_pass:-${SYNOPKG_PKG_VAR_wizard_slsk_pass:-}}"

CONFIG_FILE="${ETC_DIR}/config.json"
SLSKD_DIR="${VAR_DIR}/slskd"
SLSKD_CFG="${SLSKD_DIR}/slskd.yml"

EXISTING_USER=""
EXISTING_PASS=""
if [ -f "/volume2/docker/slskd/slskd.yml" ]; then
    EXISTING_USER="$(grep -v '^[[:space:]]*#' "/volume2/docker/slskd/slskd.yml" | grep -E '^[[:space:]]*username:' | awk '{print $2}' | tr -d ' "' | head -n 1)"
    EXISTING_PASS="$(grep -v '^[[:space:]]*#' "/volume2/docker/slskd/slskd.yml" | grep -E '^[[:space:]]*password:' | awk '{print $2}' | tr -d ' "' | head -n 1)"
fi
if [ -z "$EXISTING_PASS" ] && [ -f "$SLSKD_CFG" ]; then
    EXISTING_PASS="$(grep -v '^[[:space:]]*#' "$SLSKD_CFG" | grep -E '^[[:space:]]*password:' | awk '{print $2}' | tr -d ' "' | head -n 1)"
fi
if [ -z "$EXISTING_USER" ] && [ -f "$SLSKD_CFG" ]; then
    EXISTING_USER="$(grep -v '^[[:space:]]*#' "$SLSKD_CFG" | grep -E '^[[:space:]]*username:' | awk '{print $2}' | tr -d ' "' | head -n 1)"
fi

FINAL_SLSK_USER="${WIZARD_SLSK_USER:-$EXISTING_USER}"
FINAL_SLSK_PASS="${WIZARD_SLSK_PASS:-$EXISTING_PASS}"

if [ ! -f "$CONFIG_FILE" ]; then
cat > "$CONFIG_FILE" << CONFIG_EOF
{
  "host": "0.0.0.0",
  "port": ${PORT},
  "puid": 1026,
  "pgid": 100,
  "data_dir": "${VAR_DIR}",
  "web_dir": "${INSTALL_DIR}/web",
  "subsonic_user": "${SUB_USER}",
  "subsonic_password": "${SUB_PASS}",
  "download_dir": "${MUSIC_DIR}",
  "soulseek_enabled": true,
  "soulseek_url": "http://127.0.0.1:5030",
  "soulseek_username": $(if [ -n "$FINAL_SLSK_USER" ]; then echo "\"$FINAL_SLSK_USER\""; else echo "null"; fi),
  "soulseek_password": $(if [ -n "$FINAL_SLSK_PASS" ]; then echo "\"$FINAL_SLSK_PASS\""; else echo "null"; fi),
  "libraries": [
    {
      "name": "Synology Music Share",
      "path": "${MUSIC_DIR}",
      "is_download_target": true,
      "watch_changes": true
    }
  ]
}
CONFIG_EOF
else
  # If config.json already exists from previous install, synchronize with wizard parameters
  if [ -n "$PORT" ]; then
    sed -i -E "s/\"port\":[[:space:]]*[0-9]+/\"port\": ${PORT}/" "$CONFIG_FILE"
  fi
  if [ -n "$SUB_USER" ]; then
    sed -i -E "s/\"subsonic_user\":[[:space:]]*\"[^\"]*\"/\"subsonic_user\": \"${SUB_USER}\"/" "$CONFIG_FILE"
  fi
  if [ -n "$SUB_PASS" ]; then
    sed -i -E "s/\"subsonic_password\":[[:space:]]*\"[^\"]*\"/\"subsonic_password\": \"${SUB_PASS}\"/" "$CONFIG_FILE"
  fi
  if [ -n "$MUSIC_DIR" ]; then
    sed -i -E "s|\"download_dir\":[[:space:]]*\"[^\"]*\"|\"download_dir\": \"${MUSIC_DIR}\"|" "$CONFIG_FILE"
    sed -i -E "s|\"path\":[[:space:]]*\"/volume[0-9]+/music\"|\"path\": \"${MUSIC_DIR}\"|" "$CONFIG_FILE"
  fi
  if [ -n "$FINAL_SLSK_USER" ]; then
    if grep -q '"soulseek_username":' "$CONFIG_FILE"; then
      sed -i -E "s/\"soulseek_username\":[[:space:]]*\"[^\"]*\"/\"soulseek_username\": \"${FINAL_SLSK_USER}\"/" "$CONFIG_FILE"
      sed -i -E "s/\"soulseek_username\":[[:space:]]*null/\"soulseek_username\": \"${FINAL_SLSK_USER}\"/" "$CONFIG_FILE"
    fi
  fi
  if [ -n "$FINAL_SLSK_PASS" ]; then
    if grep -q '"soulseek_password":' "$CONFIG_FILE"; then
      sed -i -E "s/\"soulseek_password\":[[:space:]]*\"[^\"]*\"/\"soulseek_password\": \"${FINAL_SLSK_PASS}\"/" "$CONFIG_FILE"
      sed -i -E "s/\"soulseek_password\":[[:space:]]*null/\"soulseek_password\": \"${FINAL_SLSK_PASS}\"/" "$CONFIG_FILE"
    fi
  fi
fi

# Ensure sc-kvtidal has full ACL permissions on the music directory
if [ -d "$MUSIC_DIR" ]; then
    if [ -x "/usr/syno/bin/synoacltool" ]; then
        /usr/syno/bin/synoacltool -add "$MUSIC_DIR" "user:sc-kvtidal:allow:rwxpdDaARWc--:fd--" 2>/dev/null || true
    fi
    chmod 775 "$MUSIC_DIR" 2>/dev/null || true
fi



lan_ip() {
    LAN_IP=""
    if command -v ip >/dev/null 2>&1; then
        LAN_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')"
    fi
    if [ -z "$LAN_IP" ] && command -v hostname >/dev/null 2>&1; then
        LAN_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
    fi
    if [ -z "$LAN_IP" ] && command -v python3 >/dev/null 2>&1; then
        LAN_IP="$(python3 -c "import socket; s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM); s.connect(('8.8.8.8',80)); print(s.getsockname()[0]); s.close()" 2>/dev/null)"
    fi
    echo "${LAN_IP:-localhost}"
}

HOST_IP="$(lan_ip)"
[ -z "$HOST_IP" ] && HOST_IP="localhost"
if [ -f "${INSTALL_DIR}/ui/config" ]; then
    sed -i "s/@HOST@/${HOST_IP}/g; s/@PORT@/${PORT}/g" "${INSTALL_DIR}/ui/config"
fi
if [ -f "/var/packages/${PACKAGE}/INFO" ]; then
    sed -i "s/^adminport=.*/adminport=\"${PORT}\"/" "/var/packages/${PACKAGE}/INFO"
fi

chmod +x "${INSTALL_DIR}/bin/"* 2>/dev/null || true
chmod 755 "/var/packages/${PACKAGE}/scripts/"* 2>/dev/null || true

# Provision slskd (Soulseek Lossless P2P Daemon) configuration and storage
SLSKD_DIR="${VAR_DIR}/slskd"
mkdir -p "$SLSKD_DIR" "$SLSKD_DIR/incomplete"
chmod 777 "$SLSKD_DIR" "$SLSKD_DIR/incomplete" 2>/dev/null || true

SLSKD_CFG="${SLSKD_DIR}/slskd.yml"

if [ ! -f "$SLSKD_CFG" ]; then
cat > "$SLSKD_CFG" << SLSKD_EOF
web:
  port: 5030
  authentication:
    disabled: true

directories:
  downloads: "${MUSIC_DIR}"
  incomplete: "${SLSKD_DIR}/incomplete"

shares:
  directories:
    - "${MUSIC_DIR}"

soulseek:
  username: "${FINAL_SLSK_USER}"
  password: "${FINAL_SLSK_PASS}"
  listen_port: 50300
  diagnostic_level: Info
SLSKD_EOF
else
  if [ -n "$MUSIC_DIR" ]; then
    sed -i -E "s|downloads:.*|downloads: \"${MUSIC_DIR}\"|" "$SLSKD_CFG"
  fi
  if ! grep -q "shares:" "$SLSKD_CFG"; then
    cat >> "$SLSKD_CFG" << SHARES_EOF

shares:
  directories:
    - "${MUSIC_DIR}"
SHARES_EOF
  fi
  if [ -n "$FINAL_SLSK_USER" ]; then
    sed -i -E "s|username:.*|username: \"${FINAL_SLSK_USER}\"|" "$SLSKD_CFG"
  fi
  if [ -n "$FINAL_SLSK_PASS" ]; then
    sed -i -E "s|password:.*|password: \"${FINAL_SLSK_PASS}\"|" "$SLSKD_CFG"
  fi
fi
chmod 666 "$SLSKD_CFG" 2>/dev/null || true

chown -R sc-kvtidal:synocache "$ETC_DIR" "$VAR_DIR" 2>/dev/null || true
chmod 775 "$ETC_DIR" "$VAR_DIR" 2>/dev/null || true

exit 0
